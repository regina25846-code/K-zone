<Window x:Class="KrisZone.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KrisZone"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="354" SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="{x:Static local:UiFonts.Pretendard}"
        WindowStartupLocation="CenterScreen">

    <!-- ═══════════════════════════════════════════════════════════════════════
         K-SERIES ABOUT DIALOG — "Spatial Light Glass"
         이식 기준(1순위): kris_clock/dist/about.html (v1.4.1 정식배포 최종본,
         형이 Windows 실기에서 검증·컨펌한 버전). 색/문구만 K-Zone 목업
         (scratchpad/about_glass/about_kzone.html)에서 가져온다.
         K-Zone은 다크 모드가 없으므로 라이트 한 벌만 만든다.

         ── WPF 근사 규칙 (CSS와 1:1이 안 되는 부분만) ──────────────────────────
         1) backdrop-filter(실시간 배경 블러)가 WPF엔 없다. 대신 CSS의 .aura를
            "이미 부드러운 RadialGradientBrush"로 그대로 옮기고 그 위에 44% 흰
            유리판을 덮는다. BlurEffect를 쓰지 않는다 — 방사 그라디언트 자체가
            이미 블러된 모양이라 이중 블러는 계조만 뭉갠다.
         2) box-shadow 여러 겹은 Effect를 중첩하면 "그림자의 그림자"가 생겨
            지저분해진다. 대신 카드와 같은 크기·같은 라운드의 불투명 Border를
            카드 뒤에 깔고 각각 Effect 하나씩만 걸어서 진짜 레이어드 그림자를
            만든다(카드가 불투명이라 뒤 레이어는 그림자만 보인다).
         3) ⚠ Border.ClipToBounds는 CornerRadius를 따라가지 않는다(사각으로 자름).
            그래서 "둥글게 잘려야 하는 레이어"는 전부 ClipToBounds가 아니라
            CornerRadius를 가진 Border의 Background로 그린다. 아이콘 PNG도
            Image+Clip이 아니라 ImageBrush 배경으로 넣어야 모서리가 둥글다.
         4) ⚠ ClipToBounds와 Effect를 같은 요소에 걸면 그림자가 잘려 사라진다.
            여기선 ClipToBounds는 콘텐츠 Grid에만, Effect는 그 자손에게만 건다.
         5) ⚠ Setter.TargetName은 FrameworkElement만 지목할 수 있다. Freezable인
            TranslateTransform 자체는 이름으로 못 잡으므로, 호버에서 Transform을
            "통째로 교체"하는 방식을 쓴다.
         6) WPF TextBlock엔 letter-spacing이 없다. CSS의 .19em / .42em 자간은
            고정폭 공백 글리프 조합으로 근사한다(번들 Pretendard 실측:
            U+2009=0.115em, U+2006=0.166em, U+2005=0.25em, U+200A=0.066em).
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Margin = 그림자가 그려질 여백. AllowsTransparency 창이라 이 바깥은 투명.
         (K-Clock이 body padding을 10px→충분히 키워서 아래쪽 그림자 후광이 잘리던
          버그를 고친 것과 같은 이유 — WPF도 여백이 없으면 그림자가 창에 잘린다) -->
    <Grid Margin="16,14,16,22">

        <!-- ── 그림자 레이어 1 : sh-mid + sh-far ── -->
        <Border CornerRadius="21" Background="#FFEAEEF5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#121C36" Opacity="0.28"/>
            </Border.Effect>
        </Border>
        <!-- ── 그림자 레이어 2 : sh-near + sh-amb (접지감) ── -->
        <Border CornerRadius="21" Background="#FFEAEEF5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="9" ShadowDepth="2" Direction="270" Color="#121C36" Opacity="0.18"/>
            </Border.Effect>
        </Border>

        <!-- ── sh-ring : 0 0 0 1px rgba(18,28,54,.13) ──
             K-Clock 최종본에서 "카드 윗변만 각져 보인다"는 형 실기 지적을 고치려고
             추가된 토큰. 방향 있는 그림자는 윗변에 아무것도 안 남기므로, 방향 없는
             1px 링으로 사방 테두리를 만들어준다. -->
        <Border CornerRadius="21" BorderThickness="1" BorderBrush="#21121C36">

            <!-- ── 다이얼로그 셸 (.dlg) ──
                 background: linear-gradient(172deg,#EAEEF5,#DCE2EE)
                 BorderBrush = .dlg::after 프리즘 헤어라인.
                 K-Clock 최종본의 prism-start는 tint-lite가 아니라 tint 55%이며,
                 전체에 opacity:.6(prism-a)이 곱해지므로 알파를 미리 곱해 넣었다. -->
            <Border CornerRadius="20" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.53,0" EndPoint="0.47,1">
                        <GradientStop Color="#EAEEF5" Offset="0"/>
                        <GradientStop Color="#DCE2EE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#54268075" Offset="0"/>
                        <GradientStop Color="#0F121C36" Offset="0.30"/>
                        <GradientStop Color="#0F121C36" Offset="0.64"/>
                        <GradientStop Color="#50268075" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid ClipToBounds="True">

                    <!-- ══ .aura ══════════════════════════════════════════════
                         CSS는 카드보다 16% 큰 상자(inset:-16%) 안에 방사 그라디언트
                         5개를 겹친다. 카드 320x465 기준으로 중심 좌표를 카드 좌표계로
                         환산해서 MappingMode="Absolute"로 그대로 찍는다.
                         위 3개는 카드 상단에, 아래 2개는 카드 하단에 고정해서
                         (VerticalAlignment) 창 높이가 조금 달라져도 안 틀어지게 한다.
                         CSS는 먼저 쓴 것이 위에 깔리므로 e→d→c→b→a 순서로 넣는다. -->

                    <!-- (e) 280x220 at 92% 98%, tint-lite .72 -->
                    <Border VerticalAlignment="Bottom" Height="280" CornerRadius="0,0,19,19" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush MappingMode="Absolute" Center="337,342" GradientOrigin="337,342" RadiusX="280" RadiusY="220">
                                <GradientStop Color="#B8AEE5DC" Offset="0"/>
                                <GradientStop Color="#00AEE5DC" Offset="0.64"/>
                                <GradientStop Color="#00AEE5DC" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- (d) 340x280 at 10% 110%, tint .58 -->
                    <Border VerticalAlignment="Bottom" Height="280" CornerRadius="0,0,19,19" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush MappingMode="Absolute" Center="-9,416" GradientOrigin="-9,416" RadiusX="340" RadiusY="280">
                                <GradientStop Color="#94268075" Offset="0"/>
                                <GradientStop Color="#00268075" Offset="0.60"/>
                                <GradientStop Color="#00268075" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- (c) 300x240 at 100% 2%, tint .58 -->
                    <Border VerticalAlignment="Top" Height="300" CornerRadius="19,19,0,0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush MappingMode="Absolute" Center="371,-62" GradientOrigin="371,-62" RadiusX="300" RadiusY="240">
                                <GradientStop Color="#94268075" Offset="0"/>
                                <GradientStop Color="#00268075" Offset="0.62"/>
                                <GradientStop Color="#00268075" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- (b) 300x210 at 6% -10%, lift(흰빛 .95) -->
                    <Border VerticalAlignment="Top" Height="300" CornerRadius="19,19,0,0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush MappingMode="Absolute" Center="-26,-136" GradientOrigin="-26,-136" RadiusX="300" RadiusY="210">
                                <GradientStop Color="#F2FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.60"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- (a) 280x200 at 50% 20%, tint-lite .72 -->
                    <Border VerticalAlignment="Top" Height="300" CornerRadius="19,19,0,0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush MappingMode="Absolute" Center="160,48" GradientOrigin="160,48" RadiusX="280" RadiusY="200">
                                <GradientStop Color="#B8AEE5DC" Offset="0"/>
                                <GradientStop Color="#00AEE5DC" Offset="0.64"/>
                                <GradientStop Color="#00AEE5DC" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ══ .pane 유리판 ══ background: glass = rgba(255,255,255,.44) -->
                    <Border CornerRadius="19" Background="#70FFFFFF" IsHitTestVisible="False"/>
                    <!-- .pane의 위쪽 광택(linear-gradient(180deg,sheen,transparent 34%))
                         + box-shadow:inset 0 1px 0 glass-hi(위쪽 1px 하이라이트).
                         하이라이트는 Rectangle로 그리면 둥근 모서리 밖으로 직선이 삐져나오므로
                         CornerRadius를 가진 Border의 위쪽 BorderThickness로 그린다. -->
                    <Border CornerRadius="19" BorderThickness="0,1,0,0" BorderBrush="#EBFFFFFF" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8CFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.34"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ══ 콘텐츠 ══ -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ── 헤더 (.hd : padding 14px 16px, border-bottom 1px hairline) ── -->
                        <Border Grid.Row="0" BorderBrush="#17121C36" BorderThickness="0,0,0,1" Padding="16,14">
                            <Grid>
                                <!-- .hd b : 11px/700/letter-spacing .19em → U+2009+U+200A(0.1816em)로 근사 -->
                                <TextBlock Text="프&#x2009;&#x200A;로&#x2009;&#x200A;그&#x2009;&#x200A;램&#x2004;&#x2005;정&#x2009;&#x200A;보"
                                           FontSize="11" FontWeight="Bold" Foreground="#8791A2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- .x : 26px 원형, right:11px (헤더 padding 16 - 5) -->
                                <Button x:Name="CloseBtn" Width="26" Height="26"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,-5,0"
                                        Click="CloseBtn_Click" Cursor="Hand"
                                        Background="#80FFFFFF" BorderBrush="#1A121C36" BorderThickness="1"
                                        Foreground="#8791A2">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="13"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <!-- 목업 svg: viewBox 24 안의 (6,6)~(18,18)=12칸을 11px로 축소해 그린다
                                                                 → 실제 X 크기 12*(11/24)=5.5px, stroke 3*(11/24)=1.375px.
                                                                 (9x9로 그리면 64% 커져서 목업보다 훨씬 굵고 크게 보인다) -->
                                                            <Path x:Name="XIcon"
                                                                  Data="M 0,0 L 5.5,5.5 M 5.5,0 L 0,5.5"
                                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.375"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <!-- .x:hover : background glass-solid, color ink -->
                                                                <Setter TargetName="Bd" Property="Border.Background" Value="#D6FFFFFF"/>
                                                                <Setter TargetName="XIcon" Property="Shape.Stroke" Value="#141922"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ── 본문 (.bd : padding 24px 24px 22px, 가운데 정렬) ──
                             ⚠ HorizontalAlignment는 반드시 Stretch(기본값)여야 한다.
                             Center로 두면 패널 폭이 "가장 넓은 자식"까지만 줄어들어서
                             .rule(width:100%)과 버전 pill이 본문 폭 대신 설명문 폭에
                             맞춰 늘어난다(1.2.2-2 빌드에서 pill이 창을 가로지르게
                             늘어난 실제 원인). -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top"
                                    Margin="24,24,24,22" TextBlock.TextAlignment="Center">

                            <!-- ══ .mark : 글로우 + 유리 액자 + 접지 그림자 ══
                                 CSS에선 190px 글로우가 104px .mark 밖으로 그냥 넘쳐 흐르지만
                                 ⚠ WPF는 "자기 슬롯보다 큰 자식"에 레이아웃 클립을 자동으로
                                 걸어버려서(FrameworkElement.ArrangeCore) 글로우가 104px 띠로
                                 싹둑 잘린다 — HTML의 overflow:visible과 정반대다.
                                 그래서 Grid 높이를 190(글로우 크기)으로 자연스럽게 두고,
                                 대신 위아래 Margin을 음수로 깎아 레이아웃상 차지하는 높이만
                                 104 + 아래 여백 16 = 120이 되게 한다(190-43-27=120).
                                 이러면 아무것도 슬롯을 넘지 않아 클립이 걸리지 않는다. -->
                            <Grid Margin="0,-43,0,-27">

                                <!-- .mark::before — 뒤에서 퍼지는 브랜드 글로우 (이 Grid의 기준 크기) -->
                                <Ellipse Width="190" Height="190" Opacity="0.85" IsHitTestVisible="False"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#57268075" Offset="0"/>
                                            <GradientStop Color="#00268075" Offset="0.66"/>
                                            <GradientStop Color="#00268075" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- .badge — 그림자 전담(바깥) / 유리 액자(안쪽) 분리 -->
                                <Border Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="26" ShadowDepth="15" Direction="270" Color="#09514B" Opacity="0.45"/>
                                    </Border.Effect>
                                    <!-- background: color-mix(tint 15%, rgba(255,255,255,.84)) = #DCD9E9E7
                                         box-shadow inset 0 0 0 1px color-mix(tint 22%) = BorderBrush #38268075 -->
                                    <Border CornerRadius="27" BorderThickness="1" BorderBrush="#38268075" Background="#DCD9E9E7">
                                        <Grid>
                                            <!-- linear-gradient(155deg, rgba(255,255,255,.34), transparent 42%) -->
                                            <Border CornerRadius="26" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.28,0.05" EndPoint="0.72,0.95">
                                                        <GradientStop Color="#57FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- inset 0 -10px 20px -13px tint-deep : 아래쪽 안쪽 그늘 -->
                                            <Border CornerRadius="26" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#0009514B" Offset="0.76"/>
                                                        <GradientStop Color="#2409514B" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- inset 0 1.5px 0 rgba(255,255,255,.6) : 액자 윗변 하이라이트 -->
                                            <Border CornerRadius="26" BorderThickness="0,1.5,0,0" BorderBrush="#99FFFFFF" IsHitTestVisible="False"/>

                                            <!-- .badge img : 82px, border-radius 20, ico-sh
                                                 ⚠ Image+ClipToBounds는 모서리가 안 둥글어진다 → ImageBrush 배경 -->
                                            <Border Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10" Direction="270" Color="#121C36" Opacity="0.32"/>
                                                </Border.Effect>
                                                <Border CornerRadius="20" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="pack://application:,,,/Resources/app_icon.png" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Border>

                                            <!-- .badge::after : 좌상단만 스치는 광택
                                                 (CSS는 mix-blend-mode:overlay + opacity .8이라 WPF 단순 알파로는
                                                  같은 값을 그대로 쓰면 과하게 하얘진다 — 알파를 낮춰 근사) -->
                                            <Border CornerRadius="26" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.1,0.2" EndPoint="0.9,0.8">
                                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#1FFFFFFF" Offset="0.15"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.34"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- .mark::after — 바닥 접지 그림자 (액자 바닥에서 9px 아래).
                                     190 박스 기준 액자 바닥 = 43+104 = 147 → Top 정렬로 143에 놓는다.
                                     (Bottom 정렬 + 음수 Margin으로 하면 슬롯을 넘겨 클립된다) -->
                                <Ellipse Width="70" Height="13" Opacity="0.32" IsHitTestVisible="False"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,143,0,0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF09514B" Offset="0"/>
                                            <GradientStop Color="#0009514B" Offset="0.72"/>
                                            <GradientStop Color="#0009514B" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <!-- .eyebrow : 9px/700/letter-spacing .42em → U+2005+U+2006(0.416em)로 근사 -->
                            <TextBlock Text="K&#x2003;&#x200A;·&#x2003;&#x200A;S&#x2005;&#x2006;E&#x2005;&#x2006;R&#x2005;&#x2006;I&#x2005;&#x2006;E&#x2005;&#x2006;S"
                                       FontSize="9" FontWeight="Bold" Foreground="#8791A2" Margin="0,0,0,9"/>

                            <!-- .name : 24px/900. K-는 ink, Zone은 name-grad.
                                 K-Zone의 name-grad는 #09514B 단색(양끝 동일)이라 그대로 단색으로 옮긴다. -->
                            <TextBlock FontSize="24" FontWeight="Black" Margin="0,0,0,12"><Run Text="K-" Foreground="#141922"/><Run Text="Zone" Foreground="#09514B"/></TextBlock>

                            <!-- .ver : inline-flex(내용폭) → HorizontalAlignment=Center 필수 -->
                            <Border CornerRadius="999" Background="#80FFFFFF" BorderThickness="1"
                                    BorderBrush="#42268075" Padding="13,5" Margin="0,0,0,18"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="버전 1.2.2" FontSize="11.5"
                                           FontWeight="Bold" Foreground="#09514B"/>
                            </Border>

                            <!-- .rule : 본문 폭 전체, 양끝이 사라지는 헤어라인 -->
                            <Rectangle Height="1" Margin="0,0,0,16">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00121C36" Offset="0"/>
                                        <GradientStop Color="#17121C36" Offset="0.18"/>
                                        <GradientStop Color="#17121C36" Offset="0.82"/>
                                        <GradientStop Color="#00121C36" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- .desc : 13px/1.78/ink-2 -->
                            <TextBlock FontSize="13" Foreground="#525B6B" FontWeight="Medium"
                                       LineHeight="23" LineStackingStrategy="BlockLineHeight"
                                       Margin="0,0,0,12"><Run Text="윈도우 멀티 모니터 존 분할 관리"/><LineBreak/><Run Text="드래그로 앱을 정해진 영역에 배치"/></TextBlock>

                            <!-- .copy : 10.5px/ink-3, 아래 여백 19 = .act의 margin-top -->
                            <TextBlock Text="© 2026 KrisB. All rights reserved."
                                       FontSize="10.5" Foreground="#8791A2" Margin="0,0,0,19"/>

                            <!-- .btn : 그라디언트 버튼 + 새로고침 아이콘 -->
                            <Button x:Name="UpdateBtn" Click="UpdateBtn_Click" Cursor="Hand"
                                    Padding="22,11" HorizontalAlignment="Center" BorderThickness="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.77,1">
                                        <GradientStop Color="#268075" Offset="0"/>
                                        <GradientStop Color="#14635B" Offset="0.52"/>
                                        <GradientStop Color="#09514B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Viewbox로 24 viewBox → 15px 축소(스트로크 두께까지 같이 축소) -->
                                        <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M 21,12 A 9,9 0 1 1 18.36,5.64"
                                                      Stroke="White" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path Data="M 21,3 L 21,9 L 15,9"
                                                      Stroke="White" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="업데이트 확인" FontSize="13" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center">
                                            <!-- text-shadow: 0 1px 2px rgba(0,0,0,.26) -->
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.26"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- BorderThickness 위쪽 1px = box-shadow inset 0 1px 0 rgba(255,255,255,.34) -->
                                                    <Border x:Name="UBd" CornerRadius="13"
                                                            Background="{TemplateBinding Background}"
                                                            BorderThickness="0,1,0,0" BorderBrush="#57FFFFFF"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="270" Color="#09514B" Opacity="0.50"/>
                                                        </Border.Effect>
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- .btn:hover — translateY(-2px) + 더 넓은 그림자.
                                                             ⚠ Setter.TargetName으로 TranslateTransform 자체를 지목할 수 없어
                                                                RenderTransform을 통째로 갈아끼운다. -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="UBd" Property="UIElement.RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="-2"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="UBd" Property="UIElement.Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="28" ShadowDepth="13" Direction="270" Color="#09514B" Opacity="0.50"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <!-- .btn:disabled — opacity .55 -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="UBd" Property="UIElement.Opacity" Value="0.55"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- .st : 11px/ink-3, max-width 250, min-height 0
                                 ⚠ WPF TextBlock은 Text=""여도 한 줄 높이를 차지해서 버튼 아래에
                                    빈 공간이 남는다(1.2.2-2 빌드의 아래쪽 빈칸 원인).
                                    CSS의 min-height:0과 같게 만들려면 비었을 때 Collapsed 처리.
                                 ⚠ TextWrapping 없으면 긴 실패 메시지가 한 줄로 뻗어 잘린다. -->
                            <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#8791A2"
                                       Margin="0,9,0,0" MaxWidth="250" TextWrapping="Wrap"
                                       LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
