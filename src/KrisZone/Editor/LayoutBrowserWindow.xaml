<Window x:Class="KrisZone.Editor.LayoutBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-Zone 레이아웃 편집기" Width="1380" Height="850"
        MinWidth="900" MinHeight="520"
        Background="#FCFBF9" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="./Resources/Fonts/#Pretendard">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════════
             레이아웃 카드 우클릭 메뉴

             전까지는 코드에서 new ContextMenu() / new MenuItem 만 만들고 Style을
             하나도 안 줘서 WPF 기본 템플릿이 그대로 나왔다(각진 테두리, 파란
             시스템 하이라이트, 왼쪽 체크·아이콘용 빈 여백). 이 창 안에서만 쓰는
             메뉴라 App.xaml 전역이 아니라 여기 Window.Resources에 둔다.

             ── 값 출처 (전부 이 앱에 이미 있던 것. 새 색 발명 없음) ─────────────
             카드 셸        : ConfirmDialog.xaml 카드와 같은 배경 #FCFBF9
                              + 헤어라인 #DED9D1
             레이어드 그림자 : ConfirmDialog.xaml 의 "그림자 레이어 1/2" 수법 그대로
                              (Effect를 중첩하면 '그림자의 그림자'가 생기므로 같은
                               크기·같은 라운드의 불투명 Border를 뒤에 깔고 각각
                               Effect 하나씩만 건다). 그림자 색도 같은 #121C36.
                              ⚠ 크기만 줄였다 — 416px 확인창에 맞춘 blur 30/depth 8은
                                작은 메뉴에 얹으면 메뉴보다 그림자가 커 보인다.
             둥근 모서리     : 8 = 이 창 "새 레이아웃 만들기" 버튼과 같은 값
                              (항목 하이라이트 6 = 레이아웃 카드 CornerRadius와 같은 값)
             글자           : 평상시 #22252B (ConfirmDialog 제목/그만두기 글자와 같은 값)
                              크기 13 = 이 창 하단 버튼 글자와 같은 값
             위험색         : ConfirmDialog.xaml 의 위험 3색을 그대로 쓴다.
                              평상시엔 전혀 안 보이고, 마우스를 올렸을 때만 드러난다.
                                호버 : 바탕 #BC665E(가장 밝은 단) 13% + 글자 #90443D
                                눌림 : 바탕 #A94F47(기준값)  20% + 글자 #8F3B33
                              (알파만 얹었고 색상값 자체는 새로 계산하지 않았다.
                               #90443D 글자 대 호버 바탕 대비 약 5.6:1 — 같은 자리에
                               기준값 #A94F47을 쓰면 4.4:1로 AA에 살짝 못 미친다.)

             ── WPF 주의 (K-Zone에서 실제로 겪은 것) ─────────────────────────────
             1) Setter들과 Trigger.EnterActions를 섞으면 컴파일 에러가 난다
                (1.2.2-7 실측). 그래서 상태 전이는 애니메이션 없이 Setter만 쓴다.
             2) 트리거는 나중에 등록된 것이 이긴다 → IsPressed를 IsHighlighted 뒤에.
             3) ContextMenu는 별도 팝업 창에 그려지므로 그림자가 팝업 경계에서
                잘린다. 템플릿 맨 바깥 Grid에 Margin을 줘서 그림자가 그려질 자리를
                팝업 안에 확보하고, 그만큼 메뉴가 커서에서 밀려나므로
                HorizontalOffset/VerticalOffset으로 도로 당겨 붙인다.
             4) 번들 폰트는 Pretendard Regular/Bold 두 종뿐이다. SemiBold/Medium을
                쓰면 WPF가 있는 굵기로 스냅해서 위계가 뭉개지므로 여기선 Regular만.
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- ══ 메뉴 항목(지우는 동작) ═════════════════════════════════════════
             기본 MenuItem 템플릿을 통째로 갈아끼운다. 기본 템플릿에는 체크표시와
             아이콘을 놓을 왼쪽 칸이 항상 잡혀 있어서, 아이콘을 안 써도 글자가
             오른쪽으로 밀린 채 빈 칸이 남는다 — 그 칸이 "촌스러움"의 큰 몫이다.
             여기서는 Border + 글자만 남긴다. -->
        <Style x:Key="CardMenuDangerItem" TargetType="MenuItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#22252B"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                SnapsToDevicePixels="True">
                            <!-- ContentPresenter는 글자색·글자크기를 MenuItem에서
                                 상속받는다(Control.Foreground/FontSize는 TextElement의
                                 상속 속성이다). 그래서 아래 트리거는 TargetName 없이
                                 MenuItem 자체의 Foreground만 바꾸면 된다. -->
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <!-- 마우스를 올렸을 때(키보드로 옮겨왔을 때도 포함).
                                 파란 시스템 하이라이트 대신 위험색이 옅게 깔린다. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22BC665E"/>
                                <Setter Property="Foreground" Value="#90443D"/>
                            </Trigger>

                            <!-- 누르고 있는 동안 : 조금 더 짙게. 호버 트리거보다 뒤여야 이긴다. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33A94F47"/>
                                <Setter Property="Foreground" Value="#8F3B33"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#565B65"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 메뉴 상자 자체 ════════════════════════════════════════════════
             Margin="12,8,12,18" 은 그림자가 그려질 자리다(위 주의 3번).
             아래쪽이 더 넓은 이유는 그림자가 아래로(Direction 270) 6px 내려가기
             때문이다: 아래는 blur 22의 절반 11 + depth 6 = 17 필요, 옆은 11,
             위는 11-6=5 필요. 각각 18/12/8 로 여유를 뒀다. -->
        <Style x:Key="CardContextMenu" TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="./Resources/Fonts/#Pretendard"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <!-- 위 Margin 만큼 메뉴가 커서에서 떨어지므로 도로 당긴다
                 (12-2=10, 8-2=6 → 상자 왼쪽 위 모서리가 커서에서 2px 자리에 온다) -->
            <Setter Property="HorizontalOffset" Value="-10"/>
            <Setter Property="VerticalOffset" Value="-6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="12,8,12,18" MinWidth="140">

                            <!-- 그림자 레이어 1 : 멀리 퍼지는 그림자 -->
                            <Border CornerRadius="8" Background="#FCFBF9">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                                                      Color="#121C36" Opacity="0.22"/>
                                </Border.Effect>
                            </Border>

                            <!-- 그림자 레이어 2 : 바닥에 닿은 느낌(접지) -->
                            <Border CornerRadius="8" Background="#FCFBF9">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#121C36" Opacity="0.16"/>
                                </Border.Effect>
                            </Border>

                            <!-- 실제 상자 (확인창 카드와 같은 크림 바탕 + 헤어라인) -->
                            <Border CornerRadius="8" Background="#FCFBF9"
                                    BorderBrush="#DED9D1" BorderThickness="1" Padding="4">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 모니터 탭 -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Padding="24,16,24,16">
            <StackPanel x:Name="MonitorPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <Rectangle Grid.Row="1" Fill="#DED9D1"/>

        <!-- 레이아웃 콘텐츠 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
            <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>

        <Rectangle Grid.Row="3" Fill="#DED9D1"/>

        <!-- 하단 바 -->
        <Border Grid.Row="4" Background="#FCFBF9" Padding="24,12">
            <Button x:Name="NewLayoutButton" HorizontalAlignment="Right" Click="NewLayout_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2E4272" CornerRadius="8" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Foreground="White"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="새 레이아웃 만들기" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2E54"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
